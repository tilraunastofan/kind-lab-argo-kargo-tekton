{
  "apiVersion": "v3",
  "kind": "service",
  "metadata": {
    "name": "event-generator",
    "displayName": "Event Generator",
    "description": "Go demo app that writes synthetic events into ClickHouse at a low background rate, with a UI/API-triggered high-load burst.",
    "tags": [
      "lang:go",
      "lab:tekton-lab"
    ],
    "links": [
      {
        "name": "UI",
        "type": "other",
        "url": "https://event-generator.tekton-lab.test"
      },
      {
        "name": "Source",
        "type": "repo",
        "url": "https://github.com/tilraunastofan/kind-lab-argo-kargo-tekton/tree/main/demo-apps/event-generator"
      }
    ],
    "owner": "tekton-lab"
  },
  "spec": {
    "lifecycle": "experimental",
    "type": "web",
    "languages": [
      "go"
    ]
  },
  "datadog": {
    "codeLocations": [
      {
        "repositoryURL": "https://github.com/tilraunastofan/kind-lab-argo-kargo-tekton.git",
        "paths": [
          "demo-apps/event-generator/**"
        ]
      }
    ]
  }
}
